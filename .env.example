# Frontend API Configuration
# Copy this file to .env.local and adjust values as needed

# Canvas API - Icon serving and canvas creation (through API Gateway)
VITE_CANVAS_API_URL=http://localhost:8080

# Image API - Saved image retrieval (through API Gateway)
VITE_IMAGE_API_URL=http://localhost:8080

# TTS API - Text to Speech (go through API Gateway)
VITE_TTS_API_URL=http://localhost:8080/api/tts

# Pronunciation API - Speech recognition service
VITE_PRONUNCIATION_API_URL=http://localhost:8080/api/pronunciation

# API Gateway (Java microservices)
VITE_GATEWAY_URL=http://localhost:8080

# Translation API - Vietnamese-English translation service
VITE_TRANSLATE_API_URL=http://localhost:8001/api/translate
