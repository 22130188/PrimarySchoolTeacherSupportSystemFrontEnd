# Frontend API Configuration
# Copy this file to .env.local and adjust values as needed

# Canvas API - Icon serving and canvas creation
VITE_CANVAS_API_URL=http://localhost:8001

# Image API - Saved image retrieval
VITE_IMAGE_API_URL=http://localhost:8083

# TTS API - Text to Speech (usually same as Canvas API)
VITE_TTS_API_URL=http://localhost:8001

# API Gateway (Java microservices)
VITE_GATEWAY_URL=http://localhost:8080
